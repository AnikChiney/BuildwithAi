# Demo mode is the default and requires no key.
VITE_AI_MODE=demo
VITE_AI_API_URL=http://localhost:8787

# Only used when VITE_AI_MODE=real. Points at the backend/ Express server
# (backend/src/app.js) that handles auth (login/register/me), report
# submission (/api/reports/text, /api/reports/voice), and voice
# transcription. Requires GEMINI_API_KEY and MongoDB to be configured in
# backend/.env. VITE_VOICE_API_URL is kept as a deprecated fallback.
VITE_BACKEND_API_URL=http://localhost:5000
VITE_VOICE_API_URL=http://localhost:5000

# Only used by server/index.mjs. Never expose this value to Vite/frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
